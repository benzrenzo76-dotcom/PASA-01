{
  "name": "plataforma-servicios",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "mail:deliver": "node --env-file=.env --import tsx scripts/deliver-notifications.ts",
    "db:categories": "node --env-file=.env --import tsx scripts/categories.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@prisma/client": "6.19.0",
    "better-auth": "1.7.18",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.4",
      "deepmerge-ts": "8.0.2"
    }
  }
}
